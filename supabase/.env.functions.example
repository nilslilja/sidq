# Secrets for the edge functions in supabase/functions.
#
# Copy to supabase/.env.functions and fill in. That file is gitignored and must
# stay that way: STRIPE_SECRET_KEY can move money and RESEND_API_KEY can send
# mail as you.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are not here on
# purpose. Supabase injects them into every function itself and refuses to let
# them be set.
#
# The keys that used to live here — Anthropic, VAPID, ElevenLabs — belonged to
# the planner, push notifications and the voice, none of which exist any more.

# ── Payments: create-checkout, stripe-webhook ──────────────────────────────

# Stripe -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_live_

# Stripe -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe -> Product catalogue -> each price's ID
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_ANNUAL=price_
STRIPE_PRICE_DUO=price_

# Optional. Leave unset and Team stays a conversation rather than a checkout,
# which create-checkout refuses by name. Set only once a real per-seat price
# exists in Stripe.
# STRIPE_PRICE_TEAM_SEAT=price_
# STRIPE_PRICE_TEAM_SEAT_ANNUAL=price_

# Which sites may start a checkout. Comma separated, no trailing slash. A site
# missing from this list gets a CORS header for somebody else and the browser
# refuses the checkout without saying why.
ALLOWED_ORIGINS=https://www.sidq.tech,https://sidq.tech

# ── Mail: send-link (the waitlist), apply-build (the Builders' Night form) ─

# resend.com -> API keys
RESEND_API_KEY=re_

# The address mail comes from. Must be on a domain verified in Resend.
MAIL_FROM=Nils <nils@sidq.tech>
