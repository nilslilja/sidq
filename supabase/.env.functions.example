# Secrets for the two edge functions that still exist.
#
# Copy to supabase/.env.functions and fill in. That file is gitignored and must
# stay that way: STRIPE_SECRET_KEY can move money.
#
# Nothing else is needed. The keys that used to live here — Anthropic, VAPID,
# ElevenLabs — belonged to the planner, push notifications and the voice, none
# of which the product has any more.

# Stripe -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_live_

# Stripe -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe -> Product catalogue -> each price's ID
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_ANNUAL=price_
STRIPE_PRICE_DUO=price_

# Which sites may start a checkout. Comma separated, no trailing slash.
ALLOWED_ORIGINS=https://sidq.tech,https://www.sidq.tech,https://sidq.vercel.app
