# Secrets for the edge functions.
#
# Copy to supabase/.env.functions and fill in. That file is gitignored.
# These live ONLY on the server. Never prefix any of them with VITE_ — Vite
# inlines those into the browser bundle, where anyone can read them.

# ── Required for real AI plans ───────────────────────────────────────────────
# console.anthropic.com. Billed per token; roughly $0.01 per generated day.
# Without this the app silently uses the local planner and every plan is generic.
ANTHROPIC_API_KEY=

# ── Required for payment ─────────────────────────────────────────────────────
# dashboard.stripe.com. The secret key can move money: treat it accordingly.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create. Without it the webhook accepts forged
# requests, which is a public "make me a paying customer" button.
STRIPE_WEBHOOK_SECRET=

# Price IDs, from the Sidq Pro product.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_DUO=

# Where checkout is allowed to redirect back to. Comma separated, exact origins.
# Anything not listed is rejected, which is what stops an open redirect.
ALLOWED_ORIGINS=http://localhost:5173

# ── Optional ─────────────────────────────────────────────────────────────────
# Web push, for the morning and evening notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The premium voice. Without these the app uses the on-device voice, which is
# free, instant, and works offline.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
