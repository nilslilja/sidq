<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The launch agent, bundled inside the app rather than loose in
    ~/Library/LaunchAgents.

    macOS attributes a loose legacy agent to the code-signing team, which is why
    the old ~/Library/LaunchAgents/Sidq.plist showed the certificate holder's
    personal name under "Allow in the Background". An agent registered through
    SMAppService from inside the bundle is grouped under the app instead, so the
    same signature now reads as "Sidq".

    Label matches the plist filename SMAppService is asked to register, and
    doubles as the launchd job label.
  -->
  <key>Label</key>
  <string>app.sidq.desktop.agent</string>

  <!--
    Relative to the .app bundle, not an absolute path. This is the whole point:
    the loose plist hard-coded /Applications/Sidq.app/Contents/MacOS/sidq, so an
    app run from anywhere else pointed launchd at a binary that was not there.
    BundleProgram resolves against wherever the bundle actually is.
  -->
  <key>BundleProgram</key>
  <string>Contents/MacOS/sidq</string>

  <!--
    Groups the background item under this app in System Settings, so it shows
    the app's name and icon rather than the developer identity.
  -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>app.sidq.desktop</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
