{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidq",
  "version": "0.1.0",
  "identifier": "app.sidq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/overlay",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "/overlay",
        "title": "Sidq",
        "width": 380,
        "height": 132,
        "minWidth": 300,
        "minHeight": 64,
        "maxWidth": 520,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": false,
        "x": 40,
        "y": 60,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false,
        "maxHeight": 640
      },
      {
        "label": "welcome",
        "url": "/welcome",
        "title": "Welcome to Sidq",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "pill",
        "url": "/pill",
        "title": "Sidq",
        "width": 560,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "acceptFirstMouse": true,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Sidq",
    "category": "Productivity",
    "shortDescription": "One clear day, every morning.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sidq"
        ]
      }
    }
  }
}
