{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidq",
  "version": "0.1.17",
  "identifier": "app.sidq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "home",
        "url": "/home",
        "title": "Sidq",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "welcome",
        "url": "/welcome",
        "title": "Welcome to Sidq",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "pill",
        "url": "/pill",
        "title": "Sidq",
        "width": 232,
        "height": 52,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false,
        "x": 0,
        "y": 120,
        "closable": false
      },
      {
        "label": "backdrop",
        "url": "/backdrop",
        "title": "Backdrop",
        "width": 1440,
        "height": 560,
        "x": 0,
        "y": 0,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Sidq",
    "category": "Productivity",
    "shortDescription": "One clear day, every morning.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sidq"
        ]
      }
    }
  }
}
