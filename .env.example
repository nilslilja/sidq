# ---------------------------------------------------------------------------
# Client. Anything prefixed VITE_ is compiled into the bundle and is PUBLIC.
# Never put a secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_ANNUAL=

# ---------------------------------------------------------------------------
# Edge function secrets. Set with `supabase secrets set KEY=value`.
# These never reach the browser.
#
#   ANTHROPIC_API_KEY        the core IP runs on this. server only, always.
#   SIDQ_MODEL               defaults to claude-sonnet-5
#   SUPABASE_SERVICE_ROLE_KEY  bypasses RLS. never expose it to a client.
#   ALLOWED_ORIGINS          comma separated. CORS and Stripe return URLs.
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET    from `stripe listen` or the dashboard endpoint
#   STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY   npx web-push generate-vapid-keys
#   VAPID_SUBJECT            mailto: address
#   CRON_SECRET              guards send-ritual-push
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Local only, for `npm run eval`. Not used by the app.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
